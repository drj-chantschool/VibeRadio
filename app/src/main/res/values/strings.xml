    <string name="gap_param_very_long_tracks">Extra songs after a very long one</string>
    <string name="gap_param_ratio">Music per unit of podcast time (0–1)</string>
    <string name="gap_param_floor_seconds">Shortest gap; below it, episodes run back to back</string>
    <string name="gap_param_tolerance_percent">Window for a song’s end, either side</string>
