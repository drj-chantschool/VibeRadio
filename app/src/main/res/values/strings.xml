    <string name="settings_podcasts_summary">The gap between episodes on music channels</string>
    <string name="settings_podcasts_hint">How long the music runs between podcast episodes on a music channel. Pick a rule, then set its figures; each rule keeps its own. Music podcasts (Pause music on) always wait for the song to end.</string>
    <string name="settings_podcasts_params">%1$s: figures</string>
    <string name="settings_podcasts_invalid">Out of range: %1$s to %2$s.</string>
    <string name="settings_podcasts_invalid_whole">Out of range: a whole number, %1$s to %2$s.</string>
    <string name="settings_podcasts_invalid_minutes">Out of range (%1$s to %2$s), or a long episode would be longer than a very long one.</string>
    <string name="gap_rule_tracks_by_length">Tracks by episode length</string>
    <string name="gap_rule_tracks_by_length_about">The next episode waits for the song to end, plus a few more full songs after a long episode.</string>
    <string name="gap_rule_music_ratio">Music to podcast ratio</string>
    <string name="gap_rule_music_ratio_about">Music for a fraction of the podcast time just played back to back. Starts at a song’s end if one falls near that time, otherwise over the song.</string>
